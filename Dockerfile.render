# Single-container image for hosts that run one web service (e.g. Render's free tier).
# Runs the FastAPI backend on 127.0.0.1:8000 and the Next.js app on $PORT; the web app
# proxies /api to the backend, so the whole platform is served from one public URL.
# Build context: repository root.

FROM node:22-bookworm-slim AS web
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY apps/web/package.json apps/web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY apps/web ./
ENV AXIOM_API_URL=http://127.0.0.1:8000
RUN npm run build

FROM python:3.13-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 \
    NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=10000
COPY --from=web /usr/local/bin/node /usr/local/bin/node

WORKDIR /srv
COPY packages/financial-engine /srv/packages/financial-engine
COPY apps/api/pyproject.toml /srv/apps/api/pyproject.toml
COPY apps/api/app /srv/apps/api/app
RUN pip install /srv/packages/financial-engine "/srv/apps/api[s3]"
COPY apps/api/alembic /srv/apps/api/alembic
COPY apps/api/alembic.ini /srv/apps/api/alembic.ini

COPY --from=web /app/.next/standalone /srv/web
COPY --from=web /app/.next/static /srv/web/.next/static
COPY --from=web /app/public /srv/web/public
COPY infra/render-start.sh /srv/start.sh

RUN useradd --system --uid 10001 axiom && mkdir -p /data/storage && chown -R axiom /data
USER axiom
ENV AXIOM_STORAGE_PATH=/data/storage
EXPOSE 10000
CMD ["bash", "/srv/start.sh"]
